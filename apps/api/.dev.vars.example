# Copy to .dev.vars for `wrangler dev`. Values here override [vars] in wrangler.toml.

# Secret. In production set it with `wrangler secret put ADMIN_EMAILS`.
# Comma-separated emails that become admin on first sign-in
ADMIN_EMAILS=you@example.com

# Local override of [vars]: the Vite dev server
WEB_ORIGIN=http://localhost:5173

# Local override of [vars]: serve /api/openapi.json and /api/reference (off when deployed)
API_DOCS=true
