# Copy to .env. Read by wrangler itself, not the Worker: wrangler dev connects the
# HYPERDRIVE binding straight to this database. Same value as DATABASE_URL in packages/db/.env.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
