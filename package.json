{
  "name": "digibridge",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "turbo run lint typecheck test build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @digibridge/db db:generate",
    "db:push": "supabase db push",
    "db:status": "supabase migration list"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "!(*.{ts,vue})": "prettier --write --ignore-unknown"
  },
  "devDependencies": {
    "@digibridge/config": "workspace:*",
    "eslint": "catalog:",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  }
}
